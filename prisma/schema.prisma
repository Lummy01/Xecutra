generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  createdAt  DateTime   @default(now())
  guardrails Guardrail?
  missions   Mission[]
  treasury   Treasury?
}

model Vendor {
  id            String   @id @default(cuid())
  name          String   @unique
  walletId      String   @unique
  walletAddress String   @unique
  createdAt     DateTime @default(now())
}

model Treasury {
  id             String       @id @default(cuid())
  balance        Float        @default(0)
  currency       String       @default("USDC")
  createdAt      DateTime     @default(now())
  organizationId String       @unique
  walletAddress  String
  walletId       String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Guardrail {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  maxVendorSpend      Float
  minimumReserve      Float
  escrowRequired      Boolean      @default(true)
  approvedVendorsOnly Boolean      @default(false)
  createdAt           DateTime     @default(now())
  organization        Organization @relation(fields: [organizationId], references: [id])
}

model Mission {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String?
  estimatedCost  Float
  deadline       DateTime?
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now())
  aiReason       String?
  approvedAmount Float?
  selectedVendor String?
  confidence Float?

  escrow   Escrow?
  delivery Delivery? // ← Add this line

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Escrow {
  id             String    @id @default(cuid())
  missionId      String    @unique
  organizationId String
  vendor         String
  amount         Float
  status         String    @default("LOCKED")
  createdAt      DateTime  @default(now())
  releasedAt     DateTime?
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model Delivery {
  id String @id @default(cuid())

  missionId String  @unique
 mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  confirmedBy String
  status      String @default("CONFIRMED")

  createdAt DateTime @default(now())
}

model Transaction {
  id             String   @id @default(cuid())

  missionId      String
  organizationId String

  vendor         String

  amount         Float

  circleTxId     String   @unique

  status         String

  txHash         String?

  createdAt      DateTime @default(now())
}